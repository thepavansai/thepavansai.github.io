{
  "name": "thepavansai-github-io",
  "version": "1.0.0",
  "description": "Personal portfolio website",
  "source": "src/index.html",
  "homepage": "https://thepavansai.github.io",
  "scripts": {
    "start": "parcel",
    "build": "parcel build",
    "build-gh": "parcel build --public-url '/'",
    "copy-seo-assets": "mkdir -p dist && cp -f public/robots.txt public/sitemap.xml public/og-image.png dist/",
    "predeploy": "npm run build-gh && npm run copy-seo-assets",
    "deploy": "gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thepavansai/thepavansai.github.io.git"
  },
  "author": "G. Pavan Sai Sriram",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/thepavansai/thepavansai.github.io/issues"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@parcel/packager-raw-url": "^2.7.0",
    "@parcel/transformer-jsonld": "^2.7.0",
    "@parcel/transformer-webmanifest": "^2.7.0",
    "eslint": "^8.23.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-jsx-a11y": "^6.6.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.31.7",
    "gh-pages": "^5.0.0",
    "html-webpack-plugin": "^5.5.0",
    "parcel": "^2.7.0",
    "prettier": "^2.7.1",
    "process": "^0.11.10"
  }
}
